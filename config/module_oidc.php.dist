     *
     * Default: PT10M (10 minutes)
     */
    ModuleConfig::OPTION_PAR_REQUEST_URI_TTL => 'PT10M', // 10 minutes

    /**
     * Require Pushed Authorization Request (PAR) globally. If set to true,
