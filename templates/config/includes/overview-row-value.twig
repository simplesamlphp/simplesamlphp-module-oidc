{#
    Renders the value of a single configuration overview row.

    Expects:
    - row: \SimpleSAML\Module\oidc\Admin\ConfigOverview\Row

    Value types come from \SimpleSAML\Module\oidc\Codebooks\ConfigOverviewValueTypeEnum.
#}
{% set valueType = row.valueType.value %}

{% if valueType == 'url' %}

    <a href="{{ row.value }}" target="_blank" rel="noopener noreferrer">{{ row.value }}</a>

{% elseif valueType == 'stringList' %}

    {% if row.value is not empty %}
        <ul class="disc">
            {% for item in row.value %}
                <li>{{ item }}</li>
            {% endfor %}
        </ul>
    {% else %}
        {{ 'N/A'|trans }}
    {% endif %}

{% elseif valueType == 'stringMap' %}

    {% if row.value is not empty %}
        <ul class="disc">
            {% for key, values in row.value %}
                <li>
                    <strong>{{ key }}</strong>:
                    {% for value in values %}{{ value }}{{ loop.last ? '' : ', ' }}{% endfor %}
                </li>
            {% endfor %}
        </ul>
    {% else %}
        {{ 'N/A'|trans }}
    {% endif %}

{% elseif valueType == 'json' %}

    {% if row.value is not empty %}
        <code class="code-box code-box-content">
            {{- row.value|json_encode(constant('JSON_PRETTY_PRINT') b-or constant('JSON_UNESCAPED_SLASHES')) -}}
        </code>
    {% else %}
        {{ 'N/A'|trans }}
    {% endif %}

{% elseif valueType == 'signatureKeyPairs' %}

    {# The bag is null when the key pairs could not be resolved; the row warning explains why. #}
    {% for signatureKeyPair in (row.value ? row.value.getAll : []) %}
        <div class="config-key-pair">
            <strong>{{ signatureKeyPair.getSignatureAlgorithm.value }}</strong>
            {% if loop.first %}
                <em>({{ 'default'|trans }})</em>
            {% endif %}
            <br>
            {{ 'Key ID'|trans }}: <code>{{ signatureKeyPair.getKeyPair.getKeyId }}</code>
            <code class="code-box code-box-content">
                {{- signatureKeyPair.getKeyPair.getPublicKey.jsonSerialize|json_encode(constant('JSON_PRETTY_PRINT') b-or constant('JSON_UNESCAPED_SLASHES')) -}}
            </code>
        </div>
    {% endfor %}

{% elseif valueType == 'scopes' %}

    {% if row.value is not empty %}
        <ul class="disc">
            {% for scope in row.value %}
                <li>
                    <strong>{{ scope.name }}</strong>
                    <em>({{ scope.origin|trans }})</em>
                    {% if scope.description is not empty and scope.description != scope.name %}
                        &mdash; {{ scope.description }}
                    {% endif %}
                    {% if scope.claims is not empty %}
                        <br>
                        <small>
                            {{ 'Claims'|trans }}:
                            {% for claim in scope.claims %}{{ claim }}{{ loop.last ? '' : ', ' }}{% endfor %}
                        </small>
                    {% endif %}
                    {% if scope.claimNamePrefix %}
                        <br>
                        <small>{{ 'Claim name prefix'|trans }}: <code>{{ scope.claimNamePrefix }}</code></small>
                    {% endif %}
                    {% if scope.areMultipleClaimValuesAllowed %}
                        <br>
                        <small>{{ 'Multiple claim values allowed'|trans }}</small>
                    {% endif %}
                </li>
            {% endfor %}
        </ul>
    {% else %}
        {{ 'N/A'|trans }}
    {% endif %}

{% elseif valueType == 'trustAnchors' %}

    {% if row.value is not empty %}
        {% for trustAnchor in row.value %}
            <div class="config-key-pair">
                <strong>{{ trustAnchor.id }}</strong>
                <br>
                {{ 'JWKS'|trans }}:
                {% if trustAnchor.isJwksInvalid %}
                    <em class="red-text">{{ 'Invalid, expected a JWKS JSON string or null'|trans }}</em>
                {% elseif trustAnchor.jwks is not null %}
                    <code class="code-box code-box-content">{{- trustAnchor.jwks -}}</code>
                {% else %}
                    {{ 'N/A'|trans }}
                {% endif %}
            </div>
        {% endfor %}
    {% else %}
        {{ 'N/A'|trans }}
    {% endif %}

{% elseif valueType == 'trustMarks' %}

    {% if row.value is not empty %}
        {% for trustMark in row.value %}
            <div class="config-key-pair">
                <strong>{{ trustMark.type }}</strong>
                <code class="code-box code-box-content">
                    {{- trustMark.payload|json_encode(constant('JSON_PRETTY_PRINT') b-or constant('JSON_UNESCAPED_SLASHES')) -}}
                </code>
            </div>
        {% endfor %}
    {% else %}
        {{ 'N/A'|trans }}
    {% endif %}

{% elseif valueType == 'credentialConfigurations' %}

    {% if row.value is not empty %}
        {% for credentialConfiguration in row.value %}
            <div class="config-key-pair">
                <strong>{{ credentialConfiguration.id }}</strong>
                {# Tested for null rather than truthiness, so that a value like '0' still shows. #}
                {% if credentialConfiguration.format is not null %}
                    <em>({{ credentialConfiguration.format }})</em>
                {% endif %}
                {% if not credentialConfiguration.isFormatSupported %}
                    <small class="red-text">
                        ({{ 'missing or unsupported format, cannot issue credentials'|trans }})
                    </small>
                {% endif %}

                {% if credentialConfiguration.displayNames is not empty %}
                    <br>
                    <small>
                        {{ 'Display name'|trans }}:
                        {% for displayName in credentialConfiguration.displayNames %}
                            {{- displayName }}{{ loop.last ? '' : ', ' }}
                        {% endfor %}
                    </small>
                {% endif %}

                {% if credentialConfiguration.scope is not null %}
                    <br>
                    <small>{{ 'Scope'|trans }}: <code>{{ credentialConfiguration.scope }}</code></small>
                {% endif %}

                {% if credentialConfiguration.claimPaths is not empty %}
                    <br>
                    <small>
                        {{ 'Claim paths'|trans }}:
                        {% for claimPath in credentialConfiguration.claimPaths %}
                            <code>{{ claimPath }}</code>{{ loop.last ? '' : ', ' }}
                        {% endfor %}
                    </small>
                {% endif %}

                {% if credentialConfiguration.attributeMappings is not empty %}
                    <br>
                    <small>{{ 'Attribute to claim path'|trans }}:</small>
                    <ul class="disc">
                        {% for mapping in credentialConfiguration.attributeMappings %}
                            <li>
                                <small><code>{{ mapping.attribute }}</code> &rarr; <code>{{ mapping.path }}</code></small>
                                {% if mapping.ineffectiveReason == 'notDeclared' %}
                                    <small class="red-text">
                                        ({{ 'not a declared claim path, skipped during issuance'|trans }})
                                    </small>
                                {% elseif mapping.ineffectiveReason == 'droppedForFormat' %}
                                    <small class="red-text">
                                        ({{ 'declared, but outside credentialSubject, so this format discards it'|trans }})
                                    </small>
                                {% endif %}
                                {# Independent of the above: the entry itself carries attributes issuance never reads. #}
                                {% if mapping.hasIgnoredPairs %}
                                    <small class="red-text">
                                        ({{ 'this entry holds further attributes, which issuance ignores'|trans }})
                                    </small>
                                {% endif %}
                            </li>
                        {% endfor %}
                    </ul>
                {% endif %}

                {% if credentialConfiguration.jsonLdContextUrl is not null %}
                    <br>
                    <small>
                        {{ 'JSON-LD context'|trans }}:
                        <a href="{{ credentialConfiguration.jsonLdContextUrl }}"
                           target="_blank"
                           rel="noopener noreferrer"
                        >{{ credentialConfiguration.jsonLdContextUrl }}</a>
                    </small>
                {% endif %}
            </div>
        {% endfor %}
    {% else %}
        {{ 'N/A'|trans }}
    {% endif %}

{% elseif valueType == 'adminUiPermissions' %}

    {% if row.value.attribute is not null %}
        <small>{{ 'Inspected attribute'|trans }}: <code>{{ row.value.attribute }}</code></small>
    {% elseif row.value.isAttributeInvalid %}
        <small class="red-text">
            {{ 'The attribute to inspect is not a string, so no permission can be granted.'|trans }}
        </small>
    {% else %}
        {{ 'Not enabled'|trans }}
    {% endif %}

    {# Listed even when the attribute is missing, so that configured permissions are not hidden. #}
    {% if row.value.permissions is not empty %}
        <ul class="disc">
            {% for permission in row.value.permissions %}
                <li>
                    <strong>{{ permission.name }}</strong>
                    {% if permission.entitlements is not empty %}
                        <br>
                        <small>
                            {{ 'Entitlements'|trans }}:
                            {% for entitlement in permission.entitlements %}
                                <code>{{ entitlement }}</code>{{ loop.last ? '' : ', ' }}
                            {% endfor %}
                        </small>
                    {% endif %}
                    {% if permission.ineffectiveReason == 'notChecked' %}
                        <br>
                        <small class="red-text">
                            ({{ 'not a permission this module checks, so it grants nothing'|trans }})
                        </small>
                    {% elseif permission.ineffectiveReason == 'noEntitlements' %}
                        <br>
                        <small class="red-text">
                            ({{ 'no usable entitlements, so no user can be granted it'|trans }})
                        </small>
                    {% endif %}
                </li>
            {% endfor %}
        </ul>
    {% endif %}

{% elseif valueType == 'rawText' %}

    {# Configured data, shown verbatim and deliberately not translated. #}
    {{ row.value }}

{% else %}

    {{ row.value|trans }}

{% endif %}
