{% set subPageTitle = 'Credential Status'|trans %}

{% extends "@oidc/base.twig" %}

{% block oidcContent %}

    {% set csrfControl = form['_token_'].control %}

    <div class="pure-g">
        <div class="pure-u-1-2">
            <form class="pure-form" method="get" action="{{ routes.urlAdminCredentialStatus }}">
                <label>
                    <input type="text"
                           class="pure-input"
                           name="q"
                           placeholder="{{ 'Credential or user identifier'|trans }}"
                           value="{{ query|default }}"
                    />
                </label>
                <button type="submit" class="pure-button">
                    <i class="fa fa-magnifying-glass"></i>
                </button>
                <a class="pure-button" href="{{ routes.urlAdminCredentialStatus }}">{{ 'Reset'|trans }}</a>
            </form>
            <span class="pure-form-message">
                {% trans %}Enter a whole credential identifier, or the identifier of the person credentials were issued to. Both are matched exactly, since the subject is stored only as a keyed hash.{% endtrans %}
            </span>
        </div>
        <div class="pure-u-1-2">
            <div class="right">
                <small>
                    {{ 'Credentials'|trans }}: {{ total }}
                    {% if neverRetiringListCount > 0 %}
                        <br>
                        {{ 'Status Lists which can never be retired'|trans }}: {{ neverRetiringListCount }}
                    {% endif %}
                    {% if laneMismatchCount > 0 %}
                        <br>
                        <i class="fa fa-triangle-exclamation"></i>
                        {{ 'Status Lists holding a credential they should not'|trans }}: {{ laneMismatchCount }}
                    {% endif %}
                </small>
            </div>
        </div>
    </div>

    <br>

    {% if neverRetiringListCount > 0 %}
        <p>
            <small>
                {% trans %}Credentials which never expire are allocated into Status Lists of their own, so they no longer hold up the lists of credentials which do expire. Those lists still have to stay resolvable for as long as any credential in them can be presented, which is for good, so this figure is the expected cost of a credential configuration issued without a lifetime rather than a sign that anything is wrong. Setting a lifetime for a credential configuration applies to credentials issued from then on.{% endtrans %}
            </small>
        </p>
    {% endif %}

    {% if laneMismatchCount > 0 %}
        <p>
            <small>
                {% trans %}Some Status Lists hold a credential of a kind they were not created for, which should not be possible and is worth investigating: a list of expiring credentials which has taken one that never expires can no longer be retired, so its storage is never reclaimed. If this figure is above zero, check that every server issuing credentials and the server running cron are reading the same module configuration.{% endtrans %}
            </small>
        </p>
    {% endif %}

    {% if entries is empty %}
        <p>
            {% if query is not empty %}
                {{ 'No credential matches that identifier.'|trans }}
            {% else %}
                {{ 'No credentials with a status list entry have been issued.'|trans }}
            {% endif %}
        </p>
    {% else %}
        <div class="">
            <table class="pure-table pure-table-striped">
                <thead>
                    <tr>
                        <th>{{ 'Credential'|trans }}</th>
                        <th>{{ 'Status'|trans }}</th>
                        <th>{{ 'Change status'|trans }}</th>
                    </tr>
                </thead>
                <tbody>
                {% for entry in entries %}
                    <tr>
                        <td>
                            <code>{{ entry.credentialId }}</code>
                            <br>
                            <small>
                                {{ 'Configuration'|trans }}: {{ entry.credentialConfigurationId|default('n/a') }} |
                                {{ 'Subject'|trans }}:
                                {{ entry.subjectRef ? entry.subjectRef|slice(0, 16) ~ '…' : 'n/a' }} |
                                {{ 'Issued at'|trans }}: {{ entry.issuedAt ? entry.issuedAt|date() : 'n/a' }} |
                                {{ 'Expires at'|trans }}: {{ entry.expiresAt ? entry.expiresAt|date() : 'never'|trans }}
                            </small>
                        </td>
                        <td>
                            {% if entry.status == 0 %}
                                <i class="fa fa-check green-text"></i>
                            {% else %}
                                <i class="fa fa-ban red-text"></i>
                            {% endif %}
                            {% if statusLabels[entry.status] is defined %}
                                {{ statusLabels[entry.status]|trans }}
                            {% else %}
                                {{ 'Unknown'|trans }} ({{ entry.status }})
                            {% endif %}
                        </td>
                        <td>
                            <form method="post" class="pure-form" action="{{ actionRoute }}">
                                {{ csrfControl|raw }}
                                <input type="hidden" name="credential_id" value="{{ entry.credentialId }}">
                                <input type="hidden" name="q" value="{{ query|default }}">
                                <input type="hidden" name="page" value="{{ currentPage }}">
                                <select name="status">
                                    {% for value, label in allowedStatuses[entry.statusListId]|default({}) %}
                                        <option value="{{ value }}" {{ value == entry.status ? 'selected' : '' }}>
                                            {{ label|trans }}
                                        </option>
                                    {% endfor %}
                                </select>
                                <button type="submit" class="pure-button confirm-action"
                                        data-confirm-text="{{ 'Are you sure you want to change the status of this credential?'|trans }}"
                                        data-confirm-id="{{ entry.statusListId }}-{{ entry.idx }}"
                                >
                                    {{ 'Apply'|trans }}
                                </button>
                            </form>
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>

            <br>
            <div class="">
                {# A window rather than every page. A deployment issuing credentials in any volume runs
                   to thousands of pages, and a link for each would be most of what this page weighs. #}
                {% set windowStart = max(1, currentPage - 3) %}
                {% set windowEnd = min(numPages, currentPage + 3) %}
                <div class="pure-button-group" role="group" aria-label="Actions">
                    <a class="pure-button"
                       href="{{ routes.urlAdminCredentialStatus }}?{{ {page: currentPage - 1, q: query} | url_encode }}"
                       {{ currentPage == 1 ? 'disabled' }}
                    >
                        <i class="fa fa-chevron-left"></i>
                    </a>
                    {% if windowStart > 1 %}
                        <a class="pure-button"
                           href="{{ routes.urlAdminCredentialStatus }}?{{ {page: 1, q: query} | url_encode }}">
                            1
                        </a>
                        <span class="pure-button" disabled>…</span>
                    {% endif %}
                    {% for i in range(windowStart, windowEnd) %}
                        <a class="pure-button {{ currentPage == i ? 'pure-button-active' }}"
                           {{ currentPage == i ? 'disabled' }}
                           href="{{ routes.urlAdminCredentialStatus }}?{{ {page: i, q: query} | url_encode }}">
                            {{ i }}
                        </a>
                    {% endfor %}
                    {% if windowEnd < numPages %}
                        <span class="pure-button" disabled>…</span>
                        <a class="pure-button"
                           href="{{ routes.urlAdminCredentialStatus }}?{{ {page: numPages, q: query} | url_encode }}">
                            {{ numPages }}
                        </a>
                    {% endif %}
                    <a class="pure-button"
                       {{ currentPage == numPages ? 'disabled' }}
                       href="{{ routes.urlAdminCredentialStatus }}?{{ {page: currentPage + 1, q: query} | url_encode }}">
                        <i class="fa fa-chevron-right"></i>
                    </a>
                </div>
            </div>
        </div>
    {% endif %}

{% endblock oidcContent -%}
