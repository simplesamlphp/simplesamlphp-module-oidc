        {
            "match": "https://op.local.stack-dev.cirrusidentity.com/simplesaml/module.php/oidc/authorization*",
            "tasks": [
                {
                    "task": "Login",
                    "optional": true,
                    "match": "https://op.local.stack-dev.cirrusidentity.com/simplesaml/module.php/core/loginuserpass*",
                    "commands": [
                        [
                            "text",
                            "name",
                            "username",
                            "student",
                            "optional"
                        ],
                        [
                            "text",
                            "name",
                            "password",
                            "studentpass",
                            "optional"
                        ],
                        [
                            "click",
                            "id",
                            "submit_button"
                        ]
                    ]
                },
                {
                    "task": "Consent",
                    "optional": true,
                    "match": "https://op.local.stack-dev.cirrusidentity.com/simplesaml/module.php/core/loginuserpass*",
                    "commands": [
                        [
                            "click",
                            "id",
                            "submit_button"
