                    "tasks": [
                        {
                            "task": "Cancel at the login page",
                            "match": "https://op.local.stack-dev.cirrusidentity.com/simplesaml/module.php/core/loginuserpass*",
                            "commands": [
                                [
                                    "text",
                                    "name",
                                    "username",
                                    "cancel"
                                ],
                                [
                                    "text",
                                    "name",
                                    "password",
                                    "cancel"
