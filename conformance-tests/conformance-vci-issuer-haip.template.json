    "vci": {
        "credential_issuer_url": "https://op.local.stack-dev.cirrusidentity.com",
        "credential_configuration_id": "ResearchAndScholarshipCredentialDcSdJwt"
    },
    "client": {
        "client_id": "_7ff937efbab1adc7dc52218bf73fd657af340f28fe"
    },
    "client2": {
        "client_id": "_33c54116b858fb21ac5d743080d7619f201a84142b"
    },
