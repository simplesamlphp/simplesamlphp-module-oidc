    "credential": {
        "trust_anchor_pem": "set by vci-haip-config.py: docker/ssp/oidc_module_vci_trust_anchors.pem",
        "status_list_trust_anchor_pem": "set by vci-haip-config.py: docker/ssp/oidc_module_vci_trust_anchors.pem"
    },
